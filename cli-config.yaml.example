# 拓漫 TouMan CLI Configuration Example
# Copy this to ~/.hermes/config.yaml (user config) or cli-config.yaml (project config)
# and edit for your environment.
#
# Full reference: https://hermes-agent.nousresearch.com/docs/user-guide/configuration

# ─── Model ──────────────────────────────────────────────────────────────────
model:
  default: "openai/gpt-4o"           # Default model for all sessions
  provider: "openai"                 # Provider: openai, anthropic, deepseek, openrouter, etc.

# ─── Agent ──────────────────────────────────────────────────────────────────
agent:
  max_turns: 90                      # Max tool-calling iterations per session
  verbose: false                     # Enable verbose logging
  system_prompt: ""                  # Custom system prompt override

# ─── Display ────────────────────────────────────────────────────────────────
display:
  compact: false                     # Compact mode (minimal output)
  streaming: true                    # Stream responses token by token
  show_reasoning: true               # Show model reasoning/thinking
  skin: "default"                    # UI skin: default, tuoman-dark, etc.

# ─── Terminal ───────────────────────────────────────────────────────────────
terminal:
  backend: "local"                   # Backend: local, docker, ssh, modal, singularity
  timeout: 60                        # Command timeout in seconds
  lifetime_seconds: 300              # Environment cleanup timeout

  # Docker backend
  docker_image: "nikolaik/python-nodejs:python3.11-nodejs20"

  # SSH backend
  # ssh_host: "192.168.1.100"
  # ssh_user: "agent"
  # ssh_port: 22

# ─── Browser ────────────────────────────────────────────────────────────────
browser:
  inactivity_timeout: 120            # Auto-cleanup inactive browser sessions (seconds)
  engine: "auto"                     # auto, chrome, lightpanda

# ─── Security ───────────────────────────────────────────────────────────────
security:
  redact_secrets: true               # Redact sensitive info from tool output

# ─── Cron ───────────────────────────────────────────────────────────────────
cron:
  schedules:
    daily-pipeline:
      expression: "0 9 * * 1-5"     # Weekdays at 09:00
      command: "python scripts/tuoman_daily.py"
      platform: "cli"

# ─── Audio / Voice ──────────────────────────────────────────────────────────
stt:
  provider: "local"                  # local (faster-whisper), groq, openai, elevenlabs

tts:
  provider: "edge"                   # edge, openai, elevenlabs
